{
  "name": "xrf-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "preview": "vite preview",
    "preview:prod": "pnpm run build && vite preview",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write \"**/*.(js|ts|tsx|md)\" && eslint . --ext .ts,.tsx,.js --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/system": "^9.0.1",
    "@mui/x-data-grid": "^9.4.0",
    "@mui/x-tree-view": "^9.4.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@wirestate/core": "^1.0.0-experimental.15",
    "@wirestate/mobx": "^1.0.0-experimental.15",
    "@wirestate/react": "^1.0.0-experimental.15",
    "@wirestate/react-mobx": "^1.0.0-experimental.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "reactflow": "^11.11.4",
    "three": "^0.185.1"
  },
  "jest": {
    "preset": "./cli/test/jest.config.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-observing-components": "^0.2.0",
    "eslint": "^8.57.1",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unused-imports": "^3.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "mobx-react-observer": "^2.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-inline-source": "^5.0.0"
  }
